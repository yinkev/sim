# Mothership service runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=6891

# Shared service-boundary secrets
# These must match the Sim app values, stay distinct from each other, and must not reuse INTERNAL_API_SECRET.
SIM_TO_MOTHERSHIP_API_KEY=your_sim_to_mothership_runtime_secret
MOTHERSHIP_TO_SIM_CALLBACK_KEY=your_mothership_to_sim_callback_secret
MOTHERSHIP_ADMIN_API_KEY=your_mothership_admin_secret
SIM_BASE_URL=http://localhost:6888

# Storage/encryption
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/simstudio"
ENCRYPTION_KEY=your_64_character_hex_byok_storage_key
API_ENCRYPTION_KEY=your_64_character_hex_api_key_storage_key

# Owned provider credentials
MOTHERSHIP_ANTHROPIC_API_KEY=your_owned_mothership_anthropic_key
MOTHERSHIP_OPENAI_API_KEY=your_owned_mothership_openai_key
MOTHERSHIP_CLIPROXY_API_KEY=your_owned_mothership_cliproxy_key
MOTHERSHIP_PROVIDER_REQUEST_TIMEOUT_MS=600000

# Optional JSON model catalog override
MOTHERSHIP_AVAILABLE_MODELS_JSON=
