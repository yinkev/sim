{
  "name": "@sim/mothership",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "bun": ">=1.2.13",
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "biome check --write --unsafe .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "smoke:callback-outbox": "bun src/smoke/callback-outbox-concurrency.ts",
    "smoke:restart-replay": "bun src/smoke/restart-replay.ts",
    "smoke:strict-e2e-preflight": "bun src/smoke/strict-e2e-preflight.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sim/db": "workspace:*",
    "@sim/logger": "workspace:*",
    "@sim/mothership-client": "workspace:*",
    "@sim/mothership-contracts": "workspace:*",
    "@sim/security": "workspace:*",
    "@sim/utils": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@sim/testing": "workspace:*",
    "@sim/tsconfig": "workspace:*",
    "@types/node": "24.2.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  }
}
