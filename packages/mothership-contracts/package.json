{
  "name": "@sim/mothership-contracts",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.2.13",
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./routes": {
      "types": "./src/routes/index.ts",
      "default": "./src/routes/index.ts"
    },
    "./contracts/*": "./contracts/*"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "fixtures:check": "bun run ../../scripts/check-mothership-stream-fixtures.ts",
    "lint": "biome check --write --unsafe .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@sim/tsconfig": "workspace:*",
    "typescript": "^5.7.3"
  }
}
