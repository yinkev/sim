      "enum": ["allowed", "incr_error", "limited"],
      "type": "string"
    },
    "ToolAsyncWaiterResolution": {
      "enum": [
        "context_cancelled",
        "poll",
        "pubsub",
        "stored_after_close",
        "stored_before_subscribe",
